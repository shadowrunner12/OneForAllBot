[Unit]
Description=Telegram downloader / GitHub uploader bot
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=__DIR__/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
