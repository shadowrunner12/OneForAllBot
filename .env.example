API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_ID=
GITHUB_TOKEN=
GITHUB_REPO=username/repo
# ریپوی خصوصی برای فایل‌های حساس (اختیاری)
GITHUB_REPO_PRIVATE=
# آدرس عمومی سرور برای لینک دانلود ریپوی خصوصی، مثلاً http://IP-سرور:8080 (اختیاری)
PUBLIC_URL=

# اختیاری
DEFAULT_QUALITY=720
# اگر یوتیوب جواب نداد می‌تونی کلاینت رو دستی بدی، مثلاً: web_safari,tv
YT_CLIENTS=

# پوشه‌ی فایل‌های موقت (مثلاً روی دیسک جدا): WORK_DIR=/mnt/data/tgbot
